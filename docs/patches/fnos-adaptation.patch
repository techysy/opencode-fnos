@@ -1,3 +1,11 @@
+const PUBLIC_UI_PREFIXES = ["/assets/", "/favicon"]
+
 export function isPublicUIPath(method: string, pathname: string) {
-  return method === "GET" && PUBLIC_UI_PATHS.has(pathname)
+  if (method !== "GET") return false
+  // The embedded Web UI shell (HTML, JS, CSS, icons) must load without
+  // credentials so the page can render inside the fnOS desktop iframe.
+  if (pathname === "/" || pathname === "/index.html") return true
+  if (PUBLIC_UI_PREFIXES.some((prefix) => pathname.startsWith(prefix))) return true
+  if (PUBLIC_UI_PATHS.has(pathname)) return true
+  return /\.(?:js|css|png|svg|ico|webmanifest|woff2?|map)$/.test(pathname)
 }
