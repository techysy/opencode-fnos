#!/bin/bash
# OpenCode 飞牛版 — 启停控制
# 用法：main {start|stop|status|restart}
#
# v2 架构：不再使用 ttyd，直接运行 `opencode serve`（自带原生 Web UI）。
# 本脚本不写死卷路径，数据目录由 _lib.sh 推导。
set -uo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_lib.sh
. "${DIR}/_lib.sh"
opencode_resolve_paths
opencode_resolve_appdir

PORT="${TRIM_SERVICE_PORT:-19282}"
PID_FILE="${DATA_DIR}/oc.pid"

# 工作目录（用户的代码仓库）。引擎拒绝把 / 当作项目目录。
WORKSPACE="${OPENCODE_WORKSPACE:-${DATA_DIR}/workspace}"

OPENCODE_BIN="${REAL_APP_DIR}/bin/opencode"

log() { echo "[$(date '+%F %T')] $*" >> "${LOG}" 2>&1; }

# ---------------------------------------------------------------------------
# 账号与密码
#
# v2 默认强制鉴权，且飞牛桌面用 iframe 嵌入、发不了 Basic 头，
# 只能靠 ui/config 里的 ?auth_token=<base64(user:pass)>。
#
# 凭据来源优先级（高 → 低）：
#   1. 环境变量 OPENCODE_PASSWORD / OPENCODE_SERVER_PASSWORD
#   2. ${DATA_DIR}/credentials（安装向导填写，由 install_callback 写入）
#   3. 兜底默认值（仅用于极端情况，正常情况下不会走到）
#
# 见 cmd/_lib.sh 的 opencode_save_credentials / opencode_apply_token。
# ---------------------------------------------------------------------------
AUTH_USER="opencode"
PASSWORD=""

CRED_FILE="$(opencode_cred_file)"
if [ -f "${CRED_FILE}" ]; then
    AUTH_USER="$(sed -n 's/^user=//p' "${CRED_FILE}" | head -1)"
    PASSWORD="$(sed -n 's/^pass=//p' "${CRED_FILE}" | head -1)"
fi
[ -n "${AUTH_USER}" ] || AUTH_USER="opencode"

# 环境变量可覆盖（便于调试）
PASSWORD="${OPENCODE_PASSWORD:-${OPENCODE_SERVER_PASSWORD:-${PASSWORD}}}"

if [ -z "${PASSWORD}" ]; then
    # 兜底：老版本升级上来的场景，数据目录里还没有 credentials
    # 此时生成一个并立刻同步到 ui/config，避免桌面图标 401 白屏
    log "WARN: 未找到凭据，生成随机密码"
    AUTH_USER="opencode"
    PASSWORD="$(head -c 18 /dev/urandom | base64 | tr -d "=+/" | cut -c1-20)"
    ( umask 077; printf 'user=%s\npass=%s\n' "${AUTH_USER}" "${PASSWORD}" > "${CRED_FILE}" ) 2>/dev/null || true
    opencode_apply_token "$(opencode_make_token "${AUTH_USER}" "${PASSWORD}")" 2>/dev/null || true
fi

export AUTH_USER
# 注意：OpenCode 的用户名是硬编码的 "opencode"（见 packages/server/src/auth.ts），
# 这里 AUTH_USER 仅用于生成 auth_token，实际登录名始终是 opencode。
export OPENCODE_PASSWORD="${PASSWORD}"

start() {
    mkdir -p "${DATA_DIR}" "${WORKSPACE}" 2>/dev/null
    log "=== start (v2 serve) ==="

    if [ ! -x "${OPENCODE_BIN}" ]; then
        echo "ERROR: 缺少可执行文件 ${OPENCODE_BIN}" >&2
        log "ERROR: opencode not executable at ${OPENCODE_BIN}"
        return 1
    fi

    # 已在运行则直接返回
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "already running (pid $(cat "${PID_FILE}"))"
        return 0
    fi

    # 清理残留进程与陈旧 PID
    pkill -f "opencode serve .*--port ${PORT}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    sleep 1

    # 数据隔离：XDG 目录全部指向应用数据目录
    opencode_resolve_xdg
    export TERM="xterm-256color"
    export HOME="${DATA_DIR}"
    export OPENCODE_PASSWORD="${PASSWORD}"
    # 禁止自更新：应用由 fpk 管理，引擎不应自我改写
    export OPENCODE_DISABLE_AUTOUPDATE=1

    log "starting serve on 0.0.0.0:${PORT} (workspace=${WORKSPACE})"

    cd "${WORKSPACE}" || {
        echo "ERROR: 无法进入工作目录 ${WORKSPACE}" >&2
        log "ERROR: cannot cd to ${WORKSPACE}"
        return 1
    }

    # serve 默认即独立服务器，无需 --standalone
    nohup "${OPENCODE_BIN}" serve \
        --hostname 0.0.0.0 \
        --port "${PORT}" \
        >> "${LOG}" 2>&1 < /dev/null &
    PID=$!
    echo "${PID}" > "${PID_FILE}"

    # 健康检查：进程存活 + HTTP 响应即视为启动成功
    local code=""
    for _ in $(seq 1 30); do
        if ! kill -0 "${PID}" 2>/dev/null; then
            echo "ERROR: 服务启动后立即退出，见 ${LOG}" >&2
            log "ERROR: serve exited during startup"
            rm -f "${PID_FILE}"
            return 1
        fi
        code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/" 2>/dev/null)"
        # 401 表示服务已就绪（只是需要凭据），同样算启动成功
        if [ "${code}" = "200" ] || [ "${code}" = "401" ]; then
            echo "started (pid ${PID}, port ${PORT})"
            log "started OK (pid ${PID}, port ${PORT}, http=${code})"
            return 0
        fi
        sleep 1
    done

    echo "ERROR: 健康检查超时（HTTP ${code:-无响应}），见 ${LOG}" >&2
    log "ERROR: health check timeout (http=${code:-none})"
    return 1
}

stop() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}")"
        kill "${pid}" 2>/dev/null || true
        sleep 1
        kill -9 "${pid}" 2>/dev/null || true
        rm -f "${PID_FILE}"
    fi
    pkill -f "opencode serve .*--port ${PORT}" 2>/dev/null || true
    log "stopped"
    echo "stopped"
}

status() {
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "running (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/" 2>/dev/null)"
    if [ "${code}" = "200" ] || [ "${code}" = "401" ]; then
        echo "running (port ${PORT})"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    start)   start ;;
    stop)    stop ;;
    status)  status ;;
    restart) stop; sleep 1; start ;;
    *) echo "用法: $0 {start|stop|status|restart}"; exit 1 ;;
esac